# ==========================================================================
# JaksuHealth - BACKEND ENVIRONMENT VARIABLES TEMPLATE (backend/.env.example)
# ⚠️ COPY THIS FILE TO '.env' AND FILL IN THE ACTUAL VALUES.
# ==========================================================================

# 1. Database Connection for Local Development (Outside Docker)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=jaksuhealth_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# 2. Connection to External AI Servers (LLM & Computer Vision)
# ⚠️ Replace placeholders with the actual Public IPs of the corresponding EC2 instances
LLM_SERVER_URL="http://<EC2_LLM_PUBLIC_IP>:5000"
CV_SERVER_URL="http://<EC2_CV_PUBLIC_IP>:5000"
