# ==========================================================================
# JaksuHealth - ROOT ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ⚠️ COPY THIS FILE TO '.env' AND FILL IN THE ACTUAL VALUES ON YOUR SERVER.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO GIT FOR SECURITY REASONS.
# ==========================================================================

# 1. Database Configuration (Inside Docker Container on EC2)
DB_HOST="jaksu-db-local"
DB_PORT="5432"
DB_NAME="jaksuhealth_db"
DB_USER="postgres"
DB_PASSWORD="your_secure_db_password_here"

# 2. Frontend Connection to Backend API
# ⚠️ Replace <EC2_MAIN_PUBLIC_IP> with the actual Public IP of your main EC2 instance
VITE_API_URL="http://<EC2_MAIN_PUBLIC_IP>:8000/api/v1"

# 3. Connection to External AI Servers (LLM & Computer Vision)
# ⚠️ Replace placeholders with the actual Public IPs of the corresponding EC2 instances
LLM_SERVER_URL="http://<EC2_LLM_PUBLIC_IP>:5000"
CV_SERVER_URL="http://<EC2_CV_PUBLIC_IP>:5000"
